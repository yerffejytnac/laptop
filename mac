#!/bin/sh

# Modern macOS Development Environment Setup Script
# Based on thoughtbot's laptop script with customizations for modern development
# Supports both Intel and Apple Silicon Macs

# shellcheck disable=SC3043

# Utility Functions
fancy_echo() {
  local fmt="$1"; shift
  # shellcheck disable=SC2059
  printf "\\n$fmt\\n" "$@"
}

append_to_zshrc() {
  local text="$1" zshrc
  local skip_new_line="${2:-0}"

  if [ -w "$HOME/.zshrc.local" ]; then
    zshrc="$HOME/.zshrc.local"
  else
    zshrc="$HOME/.zshrc"
  fi

  if ! grep -Fqs "$text" "$zshrc"; then
    if [ "$skip_new_line" -eq 1 ]; then
      printf "%s\\n" "$text" >> "$zshrc"
    else
      printf "\\n%s\\n" "$text" >> "$zshrc"
    fi
  fi
}

gem_install_or_update() {
  if gem list "$1" --installed > /dev/null; then
    gem update "$@"
  else
    gem install "$@"
  fi
}

# Error handling and setup
# shellcheck disable=SC2154
trap 'ret=$?; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT
set -e

# Initial system setup
fancy_echo "Setting up initial directories and shell configuration..."

# Create user bin directory
if [ ! -d "$HOME/.bin/" ]; then
  mkdir "$HOME/.bin"
fi

# Create zshrc if it doesn't exist
if [ ! -f "$HOME/.zshrc" ]; then
  touch "$HOME/.zshrc"
fi

# Add user bin to PATH
# shellcheck disable=SC2016
append_to_zshrc 'export PATH="$HOME/.bin:$PATH"'

# Determine Homebrew prefix based on architecture
arch="$(uname -m)"
if [ "$arch" = "arm64" ]; then
  HOMEBREW_PREFIX="/opt/homebrew"
else
  HOMEBREW_PREFIX="/usr/local"
fi

# Shell configuration
update_shell() {
  local shell_path;
  shell_path="$(command -v zsh)"

  fancy_echo "Changing your shell to zsh ..."
  if ! grep "$shell_path" /etc/shells > /dev/null 2>&1 ; then
    fancy_echo "Adding '$shell_path' to /etc/shells"
    sudo sh -c "echo $shell_path >> /etc/shells"
  fi
  sudo chsh -s "$shell_path" "$USER"
}

case "$SHELL" in
  */zsh)
    if [ "$(command -v zsh)" != "$HOMEBREW_PREFIX/bin/zsh" ] ; then
      update_shell
    fi
    ;;
  *)
    update_shell
    ;;
esac

# Install Rosetta 2 for Apple Silicon Macs (needed for some x86 apps)
if [ "$(uname -m)" = "arm64" ]; then
  if ! pkgutil --pkg-info=com.apple.pkg.RosettaUpdateAuto > /dev/null 2>&1; then
    fancy_echo "Installing Rosetta 2 for x86 compatibility..."
    softwareupdate --install-rosetta --agree-to-license
  else
    fancy_echo "Rosetta 2 is already installed"
  fi
fi

# Homebrew installation and setup
if ! command -v brew >/dev/null; then
  fancy_echo "Installing Homebrew..."
  /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  append_to_zshrc "eval \"\$($HOMEBREW_PREFIX/bin/brew shellenv)\""
  export PATH="$HOMEBREW_PREFIX/bin:$PATH"
fi

# Remove old Homebrew-Cask if present
if brew list | grep -Fq brew-cask; then
  fancy_echo "Uninstalling old Homebrew-Cask..."
  brew uninstall --force brew-cask
fi

# Package installation via Homebrew
fancy_echo "Installing development tools and applications..."
brew update --force # https://github.com/Homebrew/brew/issues/1151

brew bundle --file=- <<EOF
# Homebrew Taps
tap "thoughtbot/formulae"
tap "mobile-dev-inc/tap"
tap "supabase/tap"

# Core Unix Tools
brew "universal-ctags"
brew "git"
brew "openssl"
brew "rcm"
brew "reattach-to-user-namespace"
brew "the_silver_searcher"
brew "tmux"
brew "vim"
brew "coreutils"
brew "libyaml"

# Shell and Terminal
brew "zsh"
brew "zsh-autosuggestions"
brew "starship"

# Runtimes
brew "oven-sh/bun/bun"
brew "deno"
brew "watchman"

# Mobile
brew "maestro"
brew "lyft/formulae/set-simulator-location"

# System Utilities
brew "dark-mode"
brew "rclone"
brew "gh"
cask "betterdisplay"
cask "iina"

# Development Applications
cask "orbstack"
cask "eloston-chromium"

# CLI Tools
brew "biome"
brew "supabase"
brew "vercel-cli"
EOF

# ASDF version manager setup
fancy_echo "Configuring asdf version manager..."
if [ ! -d "$HOME/.asdf" ]; then
  brew install asdf
  append_to_zshrc "source $(brew --prefix asdf)/libexec/asdf.sh" 1
fi

# Function to add or update asdf plugins
add_or_update_asdf_plugin() {
  local name="$1"
  local url="$2"

  if ! asdf plugin list | grep -Fq "$name"; then
    asdf plugin add "$name" "$url"
  else
    asdf plugin update "$name"
  fi
}

# Load asdf for current session
# shellcheck disable=SC1091
. "$(brew --prefix asdf)/libexec/asdf.sh"

# Add language plugins
add_or_update_asdf_plugin "ruby" "https://github.com/asdf-vm/asdf-ruby.git"
add_or_update_asdf_plugin "nodejs" "https://github.com/asdf-vm/asdf-nodejs.git"

# ASDF language installation
install_asdf_language() {
  local language="$1"
  local version
  
  if [ "$language" = "ruby" ]; then
    # For Ruby, get the latest standard Ruby version (exclude alternative implementations)
    version="$(asdf list all "$language" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | tail -1)"
  else
    # For other languages, get the last version
    version="$(asdf list all "$language" | grep -v '^$' | tail -1)"
  fi

  if ! asdf list "$language" | grep -Fq "$version"; then
    asdf install "$language" "$version"
    asdf set "$language" "$version"
  fi
}

# Install Ruby and configure bundler
fancy_echo "Installing latest Ruby..."
install_asdf_language "ruby"
gem update --system
number_of_cores=$(sysctl -n hw.ncpu)
bundle config --global jobs $((number_of_cores - 1))

# Install Node.js
fancy_echo "Installing latest Node.js..."
install_asdf_language "nodejs"

# Install global npm packages
fancy_echo "Installing global npm packages..."
npm install -g eas-cli

# Shell enhancements
fancy_echo "Configuring shell enhancements..."
append_to_zshrc "source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Ruby gems for mobile development
fancy_echo "Installing Ruby gems for mobile development..."
gem_install_or_update "cocoapods"
gem_install_or_update "fastlane"

# Custom local configuration
if [ -f "$HOME/.laptop.local" ]; then
  fancy_echo "Running your customizations from ~/.laptop.local..."
  # shellcheck disable=SC1091
  . "$HOME/.laptop.local"
fi

fancy_echo "🎉 Development environment setup complete!"
fancy_echo "Please restart your terminal or run 'source ~/.zshrc' to apply all changes."
